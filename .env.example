# এই ফাইলটার নাম কপি করে .env রাখো এবং নিজের আসল ভ্যালু বসাও।
# .env ফাইলটা কখনো গিটহাবে আপলোড কোরো না (এটা .gitignore-এ আছে)।

GEMINI_API_KEY=তোমার_gemini_api_key
YOUTUBE_API_KEY=তোমার_youtube_data_api_key

# ঐচ্ছিক: পেজে পাসওয়ার্ড প্রোটেকশন চাইলে একটা পাসওয়ার্ড বসাও, না চাইলে ফাঁকা রাখো
ACCESS_PASSWORD=

# ঐচ্ছিক: র‍্যান্ডম যেকোনো লম্বা স্ট্রিং, সেশন এনক্রিপশনের জন্য
SECRET_KEY=change-this-to-a-random-string

YOUTUBE_REGION_CODE=BD
TREND_CHECK_INTERVAL_HOURS=6
CONTENT_NICHE=general
GEMINI_MODEL=gemini-2.5-flash
PORT=10000
